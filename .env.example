META_LEAD_ACCESS_TOKEN="replace-with-a-page-or-system-user-token"
META_LEAD_PAGE_IDS="replace-with-authorized-page-id"
META_GRAPH_VERSION="v24.0"

# Conexões individuais e opcionais de anúncios (credenciais do aplicativo,
# nunca e-mail/senha dos usuários). A chave deve ter 32 bytes em base64url.
