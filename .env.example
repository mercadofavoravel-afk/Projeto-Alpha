SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Em produção sob diretório: /alpha (vazio para raiz)
NEXT_PUBLIC_ALPHA_BASE_PATH=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-before-seeding"

LOGIN_MAX_ATTEMPTS=8
LOGIN_ATTEMPT_WINDOW_MINUTES=15
APP_URL=http://localhost:3000
EMAIL_FROM=contato@example.com
RESEND_API_KEY="replace-with-a-resend-key"
CRON_SECRET="replace-with-a-random-secret-at-least-16-characters"
GOOGLE_ADS_LEAD_WEBHOOK_KEY="replace-with-a-unique-random-key"
