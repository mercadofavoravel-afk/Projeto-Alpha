{
  "name": "projeto-alpha-platform",
  "private": true,
  "version": "1.0.0-alpha.3",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "build": "prisma migrate deploy --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "typecheck": "tsc --noEmit",
    "recommendation:demo": "tsx scripts/recommendation-demo.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose down",
    "dev:bootstrap": "bash scripts/bootstrap.sh",
    "db:reset": "prisma migrate reset --schema=prisma/schema.prisma --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "next": "15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.22.0",
    "eslint-config-next": "15.5.21",
    "prettier": "3.3.3",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.8.2",
    "vitest": "2.1.9"
  }
}
