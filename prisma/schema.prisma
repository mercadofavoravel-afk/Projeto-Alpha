generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum PublishStatus { DRAFT REVIEW PUBLISHED ARCHIVED }
enum LeadStatus { NEW CONTACTED QUALIFIED VISIT_SCHEDULED WON LOST }
enum LeadObjective { LIVE INVEST PATRIMONY SELL RENT OTHER }
enum UserRole { ADMIN EDITOR CONSULTANT MARKETING VIEWER }
enum BrokerStatus {
  ACTIVE
  INACTIVE
  AWAY
  SUSPENDED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  TRANSFERRED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum TimelineEventType {
  LEAD_CREATED
  LEAD_ASSIGNED
  LEAD_VIEWED
  FIRST_RESPONSE
  STATUS_CHANGED
  STAGE_CHANGED
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_COMPLETED
  PRESENTATION_SENT
  FILE_SENT
  MESSAGE_SENT
  MESSAGE_RECEIVED
  BROKER_TRANSFERRED
  AI_STARTED
  AI_TRANSFERRED
}
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  passwordHash String
  role UserRole @default(EDITOR)
  isActive Boolean @default(true)
  passwordChangedAt DateTime?
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model Neighborhood {
  id String @id @default(cuid())
  slug String @unique
  name String @unique
  description String?
  heroImage String?
  seoTitle String?
  seoDescription String?
  projects Project[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Developer {
  id String @id @default(cuid())
  slug String @unique
  name String @unique
  description String?
  website String?
  projects Project[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())
  slug String @unique
  name String
  shortName String?
  description String
  statusLabel String?
  publishStatus PublishStatus @default(DRAFT)
  address String?
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  heroImage String?
  deliveryDate DateTime?
  priceFrom Decimal? @db.Decimal(14,2)
  priceTo Decimal? @db.Decimal(14,2)
  areaFrom Decimal? @db.Decimal(10,2)
  areaTo Decimal? @db.Decimal(10,2)
  bedroomsFrom Int?
  bedroomsTo Int?
  suitesFrom Int?
  suitesTo Int?
  parkingFrom Int?
  parkingTo Int?
  sourceUrl String?
  sourceBook String?
  seoTitle String?
  seoDescription String?
  featured Boolean @default(false)
  neighborhoodId String
  developerId String?
  neighborhood Neighborhood @relation(fields:[neighborhoodId],references:[id])
  developer Developer? @relation(fields:[developerId],references:[id])
  typologies Typology[]
  amenities ProjectAmenity[]
  collections ProjectCollection[]
  media Media[]
  sourceRecords SourceRecord[]
  bookIngestions BookIngestion[]
  recommendationResults RecommendationResult[]
  analyticsEvents AnalyticsEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([neighborhoodId])
  @@index([publishStatus])
}

model Typology {
  id String @id @default(cuid())
  name String
  description String?
  area Decimal? @db.Decimal(10,2)
  bedrooms Int?
  suites Int?
  bathrooms Int?
  parking Int?
  floorPlan String?
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
}

model Amenity { id String @id @default(cuid()) slug String @unique name String @unique description String? projects ProjectAmenity[] }
model ProjectAmenity { projectId String amenityId String featured Boolean @default(false) project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) amenity Amenity @relation(fields:[amenityId],references:[id],onDelete:Cascade) @@id([projectId,amenityId]) }
model Collection { id String @id @default(cuid()) slug String @unique name String @unique description String? heroImage String? projects ProjectCollection[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ProjectCollection { projectId String collectionId String position Int @default(0) project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade) @@id([projectId,collectionId]) }
model Media { id String @id @default(cuid()) kind String url String alt String? caption String? position Int @default(0) projectId String project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@index([projectId]) }
model BookIngestion {
  id          String        @id @default(cuid())
  fileName    String
  storageUrl  String
  mimeType    String
  status      String        @default("UPLOADED")
  progress    Int           @default(0)
  error       String?
  extracted   Json?
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId])
  @@index([status])
}

model SourceRecord { id String @id @default(cuid()) kind String title String fileName String? storageUrl String? checksum String? extractedAt DateTime? projectId String? project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull) createdAt DateTime @default(now()) @@index([projectId]) }

model LeadActivity {
  id        String   @id @default(cuid())
  type      String
  note      String?
  dueAt     DateTime?
  completedAt DateTime?
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([dueAt])
}

model Lead {
  id String @id @default(cuid())
  name String
  phone String
  email String?
  objective LeadObjective @default(OTHER)
  neighborhood String?
  budgetMin Decimal? @db.Decimal(14,2)
  budgetMax Decimal? @db.Decimal(14,2)
  message String?
  source String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  consent Boolean
  status LeadStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activities LeadActivity[]
  @@index([status])
  @@index([createdAt])
}

model Article { id String @id @default(cuid()) slug String @unique title String excerpt String? content String heroImage String? category String? publishStatus PublishStatus @default(DRAFT) seoTitle String? seoDescription String? publishedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }


enum RecommendationStatus { ACTIVE CONVERTED DISMISSED EXPIRED }

model RecommendationProfile {
  id String @id @default(cuid())
  sessionKey String? @unique
  leadId String?
  objective LeadObjective @default(OTHER)
  preferredBairros String[]
  preferredTypes String[]
  budgetMin Decimal? @db.Decimal(14,2)
  budgetMax Decimal? @db.Decimal(14,2)
  areaMin Decimal? @db.Decimal(10,2)
  bedroomsMin Int?
  suitesMin Int?
  parkingMin Int?
  proximityBeach Int @default(0)
  proximityMetro Int @default(0)
  investmentFocus Int @default(0)
  lifestyleFocus Int @default(0)
  status RecommendationStatus @default(ACTIVE)
  results RecommendationResult[]
  events AnalyticsEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([leadId])
}

model RecommendationResult {
  id String @id @default(cuid())
  profileId String
  projectId String
  score Int
  position Int
  reasons String[]
  profile RecommendationProfile @relation(fields:[profileId], references:[id], onDelete:Cascade)
  project Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([profileId,projectId])
  @@index([projectId])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  name String
  path String?
  sessionKey String?
  projectId String?
  profileId String?
  metadata Json?
  project Project? @relation(fields:[projectId], references:[id], onDelete:SetNull)
  profile RecommendationProfile? @relation(fields:[profileId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  @@index([name])
  @@index([projectId])
  @@index([createdAt])
}


model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  userAgent String?
  ipHash String?
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id String @id @default(cuid())
  emailHash String
  ipHash String?
  successful Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
} model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)

  brokers Broker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Broker {
  id          String       @id @default(cuid())
  name        String
  email       String?      @unique
  phone       String       @unique
  whatsapp    String?      @unique
  creci       String?      @unique
  status      BrokerStatus @default(ACTIVE)
  isAvailable Boolean      @default(true)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([isAvailable])
} model Pipeline {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)

  stages PipelineStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
}

model PipelineStage {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  color       String?
  position    Int     @default(0)
  probability Int     @default(0)
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)
  isActive    Boolean @default(true)

  pipelineId String
  pipeline   Pipeline @relation(
    fields: [pipelineId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, slug])
  @@index([pipelineId, position])
  @@index([isActive])
}
